rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Nur der gemeinsame Hof-Login darf lesen und schreiben.
    // E-Mail unten durch eure Hof-E-Mail ersetzen (Anleitung, Schritt 4).
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == "HOF-EMAIL-HIER-EINTRAGEN";
    }
  }
}
